# ── Claim Extraction & Chat ──────────────────────────────────────────────────
# 🟢 Groq (Used for claim extraction + chat)
# Model: llama-3.3-70b-versatile
GROQ_API_KEY=

# 🟢 NVIDIA NIM (default claim extraction model: stepfun-ai/step-3.5-flash)
NVIDIA_API_KEY=

# 🟢 OpenRouter
OPENROUTER_API_KEY=

# ── Multi-hop Adjudication ───────────────────────────────────────────────────
# 🟢 Gemini API (AI Studio) - Used for final claim adjudication (Gemini 3 Flash)
GEMINI_API_KEY=

# ── Verification Sources / Search ────────────────────────────────────────────
# 🟢 Tavily — AI-native search (returns full page content, best for NLI)
TAVILY_API_KEY=

# 🟢 Serper — Google Search aggregator (used for domain-filtered searches like SEC, News)
SERPER_API_KEY=

# 🟢 Google Fact Check Tools API
GOOGLE_FACTCHECK_API_KEY=


# ── TruthLens 开放调用（WebUI API Key页 + 外部调用）──
# 自己用：填一个 tl- 开头的主 Key，外部带 Authorization: Bearer tl-xxx 调用
# 留空 = 兼容开放模式（无 Key 也放行）；API_KEY_REQUIRED=True = 强制要 Key
TRUTHLENS_API_KEY=
API_KEY_REQUIRED=False
PORT=6655
HOST=0.0.0.0